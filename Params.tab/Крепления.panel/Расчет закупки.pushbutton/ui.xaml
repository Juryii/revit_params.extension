<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Закупка креплений — раскрой" Width="550" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="20">
    <TextBlock Text="Все подвесы РП в текущем проекте" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
    <TextBlock Text="Длина закупаемой шпильки, мм"/>
    <TextBox x:Name="rod_length" Text="3000" Margin="0,4,0,10"/>
    <TextBlock Text="Длина закупаемой траверсы, мм"/>
    <TextBox x:Name="channel_length" Text="3000" Margin="0,4,0,10"/>
    <TextBlock Text="Потеря на один рез, мм"/>
    <TextBox x:Name="kerf" Text="0" Margin="0,4,0,10"/>
    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,8,0">
        <TextBlock Text="Припуск на одну шпильку, мм"/>
        <TextBox x:Name="rod_allowance" Text="0" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Text="Припуск на одну траверсу, мм"/>
        <TextBox x:Name="channel_allowance" Text="0" Margin="0,4,0,0"/>
      </StackPanel>
    </Grid>
    <TextBlock TextWrapping="Wrap" Text="Припуск добавляется один раз к длине каждой детали для закупки и раскроя. Например, 920 + 50 = 970 мм. Размеры в модели и спецификации остаются прежними." Margin="0,0,0,10"/>
    <CheckBox x:Name="deep_search" Content="Настроить расширенный поиск" Margin="0,2,0,8"/>
    <StackPanel IsEnabled="{Binding ElementName=deep_search, Path=IsChecked}">
      <TextBlock Text="Общий лимит времени поиска, секунд (300 = 5 минут)"/>
      <TextBox x:Name="search_seconds" Text="300" Margin="0,4,0,10"/>
      <TextBlock Text="Общий лимит шагов поиска"/>
      <TextBox x:Name="search_steps" Text="10000000" Margin="0,4,0,10"/>
    </StackPanel>
    <TextBlock TextWrapping="Wrap" Text="Без галочки: быстрый поиск, до 0,4 с / 30 000 шагов. Лимиты общие для всех профилей и резьб; поиск завершится по первому достигнутому лимиту или при доказанном минимуме. Сбор данных и вывод отчёта занимают дополнительное время." Margin="0,0,0,12"/>
    <TextBlock TextWrapping="Wrap" Text="По одному резу на каждый отрезок; целая заготовка без реза. Остатки объединяются между системами одного проекта. Связанные модели не учитываются." Margin="0,0,0,14"/>
    <TextBlock x:Name="error" Foreground="Firebrick" TextWrapping="Wrap"/>
    <Button Content="Рассчитать" Click="calculate" IsDefault="True" Height="32" Margin="0,8,0,0"/>
  </StackPanel>
  </ScrollViewer>
</Window>
